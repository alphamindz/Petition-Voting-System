# ==========================================
# Root .gitignore for Petition Voting System
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
!*/.env.example
server/.env
server/.env.*
client/.env
client/.env.*
*.env

# Production Build Outputs
dist/
dist-ssr/
build/
client/dist/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
